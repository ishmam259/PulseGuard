# ═══════════════════════════════════════
# PulseGuard AI — Environment Variables
# ═══════════════════════════════════════

# Database
DATABASE_URL=postgres://postgres:wirelight@localhost:5432/pulseguard

# JWT
JWT_SECRET=pulseguard_jwt_secret_change_in_production
JWT_REFRESH_SECRET=pulseguard_refresh_secret_change_in_production

# AI Worker
AI_WORKER_URL=http://localhost:8000

# Matrix Conduit (Community Chat)
CHAT_SECRET=change_this_to_a_long_random_string
MATRIX_BASE_URL=http://localhost:6167
GLOBAL_CHAT_ROOM_ID=!pulseguard-global:localhost

# Gemini (optional — leave empty for mock mode)
GEMINI_API_KEY=

# Server
PORT=5000
NODE_ENV=development

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_ID=your-google-client-id
